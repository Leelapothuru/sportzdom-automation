# Copy to .env (git-ignored) and fill in for local runs; config/settings.py loads it.
# In Azure DevOps, set these as pipeline variables instead (credentials as secrets).

# Demo-account test credentials
SPORTZDOM_DEMO_EMAIL=
SPORTZDOM_DEMO_PASSWORD=

# Device (from `adb devices`). Leave UDID empty to use the only connected device.
SPORTZDOM_DEVICE_NAME=
SPORTZDOM_DEVICE_UDID=

# Optional overrides (defaults shown)
# SPORTZDOM_APPIUM_URL=http://127.0.0.1:4723
# SPORTZDOM_APP_PACKAGE=com.sportzdom.app
# SPORTZDOM_APP_ACTIVITY=.MainActivity
